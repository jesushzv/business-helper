# ==============================================================================
# Business Helper: Production & Local Environment Variables Template
# Copy this file to .env.local for local development, or set these variables in
# your cloud platform environment settings (Vercel, Netlify, Railway).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Backend Infrastructure (Database, Auth & Storage)
# Required for multi-tenant database access, RLS policies, and SPEI receipts
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# ------------------------------------------------------------------------------
# 2. SAT CFDI 4.0 PAC Invoicing (Facturapi.io)
# Required for 1-click electronic invoice stamping in Mexico
# Sandbox Key format: sk_test_... | Production Key format: sk_live_...
# ------------------------------------------------------------------------------
FACTURAPI_SECRET_KEY=sk_test_your_facturapi_secret_key

# ------------------------------------------------------------------------------
# 3. Stripe Subscription Billing ($299 / $599 / $999 MXN)
# Required for SaaS billing checkout sessions and webhook entitlement listener
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret
STRIPE_PRICE_EMPRENDEDOR=price_12345_emprendedor_299mxn
STRIPE_PRICE_NEGOCIO=price_12345_negocio_599mxn
STRIPE_PRICE_EMPRESA=price_12345_empresa_999mxn

# ------------------------------------------------------------------------------
# 4. Outbound Automated WhatsApp API (Twilio / Meta WhatsApp Business)
# Fallback to wa.me deep links active when credentials are absent
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=ACyour_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+14155238886

# ------------------------------------------------------------------------------
# 5. Gemini AI Operations Assistant (@google/genai)
# Required for natural language receivables query parsing & smart reminders
# ------------------------------------------------------------------------------
GEMINI_API_KEY=AIzaSyYourGeminiAPIKeyHere

# ------------------------------------------------------------------------------
# 6. Application Environment & Media CDN Flags
# Set to 'production' on Vercel deployment with production CDN storage URL
# ------------------------------------------------------------------------------
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://businesshelper.mx
NEXT_PUBLIC_CDN_URL=https://cdn.businesshelper.mx
